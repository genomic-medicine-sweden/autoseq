nextflow_pipeline {

    name "Test pipeline"
    script "../main.nf"
    tag "pipeline"

    test("test profile - paired tumor-normal") {

        when {
            params {
                outdir          = "$outputDir"
                maxnonclonal    = 1.0           // Relax `maxnonclonal` to 1.0 so PureCN doesn't fail on this tiny test genome.
            }
        }

        then {
            // stable_path: All files + folders in ${params.outdir}/ with a stable path (including file name)
            def stable_path = getAllFilesFromDir(params.outdir, relative: true, includeDir: true, ignore: ['pipeline_info/*.{html,json,txt}'])
            // stable_content: All files + folders in ${params.outdir}/ with a stable content (including file name)
            def stable_content = getAllFilesFromDir(params.outdir, ignoreFile: 'tests/.nftignore')
            def bam_files = getAllFilesFromDir(params.outdir, include: ['**/*.bam'])
            def vcf_files = getAllFilesFromDir(params.outdir, include: ['**/*.vcf.gz'])
            assert workflow.success
            assertAll(
                { assert snapshot(
                    // Number of successful tasks
                    workflow.trace.succeeded().size(),
                    removeNextflowVersion("$outputDir/pipeline_info/autoseq_software_mqc_versions.yml"),
                    stable_path,
                    stable_content,
                    bam_files.collect { file -> [ file.getName(), bam(file.toString(), stringency: 'silent').getReadsMD5() ] },
                    vcf_files.collect { file -> [ file.getName(), path(file.toString()).vcf.variantsMD5 ] }
                ).match() }
            )
        }
    }

    test("test profile - paired tumor-normal - stub") {

        options "-stub "

        when {
            params {
                outdir = "$outputDir"
            }
        }

        then {
            def stable_path = getAllFilesFromDir(params.outdir, relative: true, includeDir: true, ignore: ['pipeline_info/*.{html,json,txt}'])
            assert workflow.success
            assertAll(
                { assert snapshot(
                    workflow.trace.succeeded().size(),
                    removeNextflowVersion("$outputDir/pipeline_info/autoseq_software_mqc_versions.yml"),
                    stable_path,
                ).match() }
            )
        }
    }
}
