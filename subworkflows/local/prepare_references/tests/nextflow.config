process {

    withName: '.*PREPARE_REFERENCES:BWAMEM2_INDEX' {
        ext.prefix = { "${meta.id}_bwamem2_index" }
    }

    withName: '.*PREPARE_REFERENCES:UNTAR_VEP_CACHE' {
        ext.prefix = { "${meta.id}_untar_vep_cache" }
    }

    withName: '.*PREPARE_REFERENCES:UNTAR_GRIDSS_INDEX' {
        ext.prefix = { "${meta.id}_untar_gridss_index" }
    }
    withName: '.*PREPARE_REFERENCES:UNTAR_HMF_ENSEMBL_DATA' {
        ext.prefix = { "${meta.id}_untar_hmf_ensembl_data" }
    }
}
