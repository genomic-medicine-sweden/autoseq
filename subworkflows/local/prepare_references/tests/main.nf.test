nextflow_workflow {

    name "Test Subworkflow PREPARE_REFERENCES"
    script "../main.nf"
    workflow "PREPARE_REFERENCES"

    tag "subworkflows"
    tag "subworkflows_local"
    tag "prepare_references"
    tag "bwamem2"
    tag "bwamem2/index"
    tag "untar"

    topics "versions"

    test("No indexing or untarring need") {

        when {
            workflow {
                """
                input[0] = params.pipelines_testdata_base_path + 'reference/GRCh37/genome/human_g1k_v37_decoy.fasta'
                input[1] = params.pipelines_testdata_base_path + 'reference/GRCh37/genome/human_g1k_v37_decoy.fasta.fai'
                input[2] = params.pipelines_testdata_base_path + 'reference/GRCh37/vep/homo_sapiens/115_GRCh37'
                input[3] = null
                input[4] = params.pipelines_testdata_base_path + 'reference/GRCh37/gridss_index/'
                input[5] = null
                input[6] = params.pipelines_testdata_base_path + 'dummy/path/to/ensembl/data/directory'
                input[7] = null
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert snapshot(
                    sanitizeOutput(workflow.out),
                    topics, // Ensure that no processes are run
                ).match() }
            )
        }
    }

    test("build bwamem2 index and untar directories") {

        when {
            workflow {
                """
                // No pre-built index/cache/data paths provided, so the subworkflow
                // builds the BWA-MEM2 index and untars the VEP, GRIDSS and HMF archives.
                input[0] = params.pipelines_testdata_base_path + 'reference/GRCh37/genome/human_g1k_v37_decoy.fasta'
                input[1] = null
                input[2] = null
                input[3] = params.pipelines_testdata_base_path + 'reference/GRCh37/vep.tar.gz'
                input[4] = null
                input[5] = params.pipelines_testdata_base_path + 'reference/GRCh37/gridss_index.tar.gz'
                input[6] = null
                input[7] = params.pipelines_testdata_base_path + 'reference/GRCh37/ensembl_data.tar.gz'
                input[8] = null
                input[9] = params.modules_testdata_base_path + 'genomics/homo_sapiens/msisensor2/models_hg19_17sites.tar.gz'
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert snapshot(
                    sanitizeOutput(workflow.out),
                    topics, // Ensure relevant processes are run
                ).match() }
            )
        }
    }

    test("build bwamem2 index and untar directories - stub") {

        options "-stub"

        when {
            workflow {
                """
                input[0] = params.pipelines_testdata_base_path + 'reference/GRCh37/genome/human_g1k_v37_decoy.fasta'
                input[1] = null
                input[2] = null
                input[3] = params.pipelines_testdata_base_path + 'reference/GRCh37/vep.tar.gz'
                input[4] = null
                input[5] = params.pipelines_testdata_base_path + 'reference/GRCh37/gridss_index.tar.gz'
                input[6] = null
                input[7] = params.pipelines_testdata_base_path + 'reference/GRCh37/ensembl_data.tar.gz'
                input[8] = null
                input[9] = params.modules_testdata_base_path + 'genomics/homo_sapiens/msisensor2/models_hg19_17sites.tar.gz'
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert snapshot(
                    sanitizeOutput(workflow.out),
                    topics, // Ensure relevant processes are run
                ).match() }
            )
        }
    }
}
