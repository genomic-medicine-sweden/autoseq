// Mirrors the `.*:ALIGNMENT:*` selectors from `conf/modules.config`. nf-test invokes the
// subworkflow as the top-level workflow, so the process names are not prefixed by the
// pipeline workflow and the `.*:` selectors of `conf/modules.config` do not match.

process {
    withName: '.*ALIGNMENT:BWAMEM2_MEM' {
        ext.args = { "-Y -K 100000000 -R ${meta.read_group}" }
    }

    withName: '.*ALIGNMENT:MARKDUPLICATES' {
        ext.args = '--REMOVE_DUPLICATES true --CREATE_INDEX true --VALIDATION_STRINGENCY SILENT'
        ext.prefix = { "${meta.id}_dedup.bam" }
    }
}
