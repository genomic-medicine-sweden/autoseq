/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options for the CALL_SOMATIC_SNVS subworkflow
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

process {

    withName: '.*CALL_SOMATIC_SNVS:ANNOTATE_VEP' {
        ext.args   = {
            [
                "--vcf",
                "--pick",
                "--check_existing",
                "--total_length",
                "--allele_number",
                "--no_escape",
                "--no_stats",
                "--everything",
                "--offline",
            ].join(' ')
        }
        ext.args2  = { "-p vcf" }
        ext.prefix = { "${meta.tumor_id}_${meta.normal_id}-all.somatic.vep" }
    }

    withName: '.*CALL_SOMATIC_SNVS:CALL_GATK_MUTECT2:GATK4_CALCULATECONTAMINATION' {
        ext.args   = { "--tumor-segmentation ${meta.id}.segmentation.table" }
        ext.prefix = { "${meta.tumor_id}_${meta.normal_id}" }
    }

    withName: '.*CALL_SOMATIC_SNVS:CALL_GATK_MUTECT2:GATK4_FILTERMUTECTCALLS' {
        ext.prefix = { "${meta.tumor_id}_${meta.normal_id}_mutect2_filtered" }
    }

    withName: '.*CALL_SOMATIC_SNVS:CALL_GATK_MUTECT2:GATK4_GETPILEUPSUMMARIES_NORMAL' {
        ext.prefix = { "${meta.id}_${meta.normal_id}" }
    }

    withName: '.*CALL_SOMATIC_SNVS:CALL_GATK_MUTECT2:GATK4_GETPILEUPSUMMARIES_TUMOR' {
        ext.prefix = { "${meta.id}_${meta.tumor_id}" }
    }

    withName: '.*CALL_SOMATIC_SNVS:CALL_GATK_MUTECT2:GATK4_MUTECT2' {
        // these germline variants including parameters are required for purecn in the downstream
        ext.args   = {
            [
                "--f1r2-tar-gz ${meta.id}.f1r2.tar.gz",
                "--normal-sample ${meta.normal_id}",
                "--genotype-germline-sites true",
                "--genotype-pon-sites true",
            ].join(' ')
        }
    }

    withName: '.*CALL_SOMATIC_SNVS:INDEX_VCF' {
        ext.args   = { "-p vcf" }
    }

    withName: '.*CALL_SOMATIC_SNVS:PASSFILTER_FOR_MUTECT2' {
        // Emit bgzipped + tabix-indexed VCF so SOMATIC_VCFMERGE's `bcftools concat -a`
        // (allow-overlaps) can load the index; -a requires indexed inputs.
        ext.args   = { "-i 'FILTER=\"PASS\"' --output-type z --write-index=tbi" }
        ext.prefix = { "${meta.tumor_id}_${meta.normal_id}_mutect2_pass_only" }
    }

    withName: '.*CALL_SOMATIC_SNVS:PASSFILTER_FOR_SAGE' {
        ext.args   = { "-i 'FILTER=\"PASS\"'" }
        ext.prefix = { "${meta.tumor_id}_${meta.normal_id}_sage_pass_only" }
    }

    withName: '.*CALL_SOMATIC_SNVS:SAGE_SOMATIC' {
        ext.prefix = { "${meta.tumor_id}_${meta.normal_id}_sage" }
    }

    withName: '.*CALL_SOMATIC_SNVS:SOMATIC_VCFMERGE' {
        ext.prefix = { "${meta.tumor_id}_${meta.normal_id}" }
    }

    withName: '.*CALL_SOMATIC_SNVS:VT_NORMALIZE' {
        ext.prefix = { "${meta.tumor_id}_${meta.normal_id}_mutect2_filtered_normalized" }
    }

}
