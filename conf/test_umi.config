/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests of the UMI branch
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Same tiny GRCh37 references and test_panel as `-profile test`, but with reads
    carrying inline duplex UMIs so the CAT_FASTQ -> UMI_PROCESSING -> SAMTOOLS_INDEX
    branch is exercised instead of the FASTP/BWA-MEM2/MarkDuplicates one.

    Use as follows:
        nextflow run genomic-medicine-sweden/autoseq -profile test_umi,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

includeConfig 'test.config'

params {
    config_profile_name        = 'UMI test profile'
    config_profile_description = 'Minimal test dataset to check the UMI branch of the pipeline'

    // Input data
    // The reads are the `-profile test` FASTQs with a 3 bp UMI and a 2 bp spacer
    // prepended to both mates, each source molecule emitted once per strand so
    // fgbio can build duplex (AB/BA) families. `duplex`, `min_reads`, `min_baseq`
    // and `max_base_error_rate` are left at their nextflow.config defaults so
    // duplex consensus calling is covered.
    input         = params.pipelines_testdata_base_path + 'testdata/csv/samplesheet_grch37_umi.csv'
    umi_structure = '3M2S+T 3M2S+T'
}
