/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a fast and simple pipeline test.

    Use as follows:
        nextflow run genomic-medicine-sweden/autoseq -profile test,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus: 4,
        memory: '15.GB',
        time: '1.h'
    ]

    // The test-genome contigs (<=200 kb) are far smaller than SAGE's hardcoded BQR
    // end-sampling window (END_BUFFER 1 Mb + sample size 2 Mb), so BQR builds
    // negative-coordinate regions and crashes. Disable BQR for the tiny test genome;
    // full-size production genomes are unaffected.
    withName: SAGE_SOMATIC {
        ext.args = '-bqr_disable'
    }
}

params {
    config_profile_name        = 'Test profile'
    config_profile_description = 'Minimal test dataset to check pipeline function'

    // Input data
    input             = params.pipelines_testdata_base_path + 'testdata/csv/samplesheet_grch37.csv'

    // Genome references
    genome            = 'GRCh37'
    igenomes_ignore   = true
    ref_genomes_base  = 'https://raw.githubusercontent.com/imsarath/test-data/refs/heads/main/reference'

    // Single-file references (FASTA, dbSNP, gnomAD, hmfdata/*, gridss/*, curation CSV) are
    // resolved directly from conf/reference_genomes.config against ref_genomes_base — the raw
    // GitHub URLs stage each file individually, so no per-file overrides are needed here.
    //
    // Directory-type references cannot be staged from raw GitHub URLs, so they are shipped as
    // single-file tarballs and unpacked at runtime by the PREPARE_REFERENCES subworkflow. The
    // BWA-MEM2 index is built on-the-fly from the FASTA, so bwamem2_index is left unset.
    bwamem2_index          = null
    ensembl_vep_cache      = null
    ensembl_data_resources = null
    genome_gridss_index    = null

    ensembl_vep_cache_tar  = "${params.ref_genomes_base}/GRCh37/vep.tar.gz"
    gridss_index_tar       = "${params.ref_genomes_base}/GRCh37/gridss_index.tar.gz"
    hmf_ensembl_data_tar   = "${params.ref_genomes_base}/GRCh37/ensembl_data.tar.gz"

    // Target panel
    panels {
        test_panel {
            targets_bed_slopped20           = "${params.ref_genomes_base}/GRCh37/targets/test_panel.targets.slopped20.bed"
            targets_bed_slopped20_gz        = "${params.ref_genomes_base}/GRCh37/targets/test_panel.targets.slopped20.bed.gz"
            targets_interval_list           = "${params.ref_genomes_base}/GRCh37/targets/test_panel.targets.interval_list"
            targets_interval_list_slopped20 = "${params.ref_genomes_base}/GRCh37/targets/test_panel.targets.slopped20.interval_list"
            jumble_ref                      = "${params.ref_genomes_base}/GRCh37/targets/test_panel.bed.reference.RDS"
        }
    }

    panel  = 'test_panel' // Target panel BED file

    // PureCN's 2D purity/ploidy grid search rejects every candidate whose subclonal
    // (noise-model) genome fraction exceeds `maxnonclonal` (default 0.2), aborting with
    // "Cannot find valid purity/ploidy solution". The tiny test genome produces flat,
    // copy-number-neutral segments, so every candidate is rejected. Relax the threshold to
    // 1.0 for the test profile so PureCN converges and the pipeline runs end-to-end. The
    // resulting purity/ploidy call is not biologically meaningful — this test exercises
    // pipeline wiring, not PureCN accuracy; production keeps the strict default.
    maxnonclonal = 1.0
}
